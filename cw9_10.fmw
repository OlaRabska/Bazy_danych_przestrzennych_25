Tcl2 proc $(FilePropertyExtractor_WORKSPACE_NAME)_ParameterFetcher_doFetch {} {    foreach {name val} {"__filepropertyextractor.path {$($(FilePropertyExtractor_WORKSPACE_NAME)_PATH)}"} {         if { [string match {*<at>*} $val] == 1 } {             set val [FME_Execute EvaluateExpression {STRING} $val {$(FilePropertyExtractor_WORKSPACE_NAME)_ParameterFetcher}];         } elseif {[string match {*FME_CONDITIONAL*} $val] == 1} {             set val [FME_Execute EvaluateExpression {STRING} $val {$(FilePropertyExtractor_WORKSPACE_NAME)_ParameterFetcher}];         } else {             set val [FME_DecodeTextOrAttr $val];         };       FME_SetAttribute [FME_DecodeText $name] $val    } }
FACTORY_DEF {*} TeeFactory    FACTORY_NAME { $(FilePropertyExtractor_WORKSPACE_NAME)_ParameterFetcher }    INPUT  FEATURE_TYPE "$(FilePropertyExtractor_WORKSPACE_NAME)_Input"    OUTPUT { FEATURE_TYPE "$(FilePropertyExtractor_WORKSPACE_NAME)_ParameterFetcher_OUTPUT"         @Tcl2($(FilePropertyExtractor_WORKSPACE_NAME)_ParameterFetcher_doFetch)          }
