GEODATABASE_FILE_1_DISABLE_FEATURE_DATASET_ATTRIBUTE "$(GEODATABASE_FILE_IN_DISABLE_FEATURE_DATASET_ATTRIBUTE_GEODATABASE_FILE_1)"
DEFAULT_MACRO GEODATABASE_FILE_IN_FME_CONNECTION_GROUP_GEODATABASE_FILE_1 
