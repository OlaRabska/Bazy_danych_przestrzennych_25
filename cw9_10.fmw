#!   FMX_ATTRIBUTE_PROPOGATION_MODE="AUTO"
#!   GUID="bcf8e940-4ad6-44f6-a18e-be03c3d6911d"
#!   HISTORY="2016-05-25,Takashi&lt;space&gt;Iijima,Original&lt;space&gt;Implementation,2020-01-28,Takashi&lt;space&gt;Iijima,Calculate&lt;space&gt;Directory&lt;space&gt;Size&lt;space&gt;as&lt;space&gt;Total&lt;space&gt;File&lt;space&gt;Sizes&lt;space&gt;under&lt;space&gt;the&lt;space&gt;Directory&lt;semicolon&gt;&lt;space&gt;Changed&lt;space&gt;Default&lt;space&gt;Python&lt;space&gt;Interpreter&lt;space&gt;to&lt;space&gt;3.6+"
#!   IS_VISIBLE="false"
#!   LAST_SAVE_BUILD="FME(R) 2017.1.2.1 (20180117 - Build 17725 - WIN64)"
#!   LAST_SAVE_DATE="2020-01-28T19:59:10"
#!   MARKDOWN_DESCRIPTION=""
#!   MARKDOWN_USAGE=""
#!   PYTHON_COMPATIBILITY=""
