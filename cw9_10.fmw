FACTORY_DEF {*} PythonFactory    FACTORY_NAME { $(FilePropertyExtractor_WORKSPACE_NAME)_PythonCaller }    FLUSH_WHEN_GROUPS_CHANGE { <Unused> }    INPUT  FEATURE_TYPE "$(FilePropertyExtractor_WORKSPACE_NAME)_ParameterFetcher_OUTPUT"    SYMBOL_NAME { extractFileProperty }    SOURCE_CODE { #<space>2016-05-25<comma><space>Takashi<space>Iijima<comma><space>Original<space>Implementation<lf>#<space>2020-01-28<comma><space>Takashi<space>Iijima<comma><space>Calculate<space>Directory<space>Size<space>as<space>Total<space>File<space>Sizes<space>under<space>the<space>Directory<semicolon><space>Changed<space>Default<space>Python<space>Interpreter<space>to<space>3.6+<lf><lf>import<space>fme<comma><space>fmeobjects<lf>import<space>os<lf>def<space>extractFileProperty<openparen>feature<closeparen>:<lf><space><space><space><space>def<space>get_dir_size<openparen>path<closeparen>:<lf><space><space><space><space><space><space><space><space>total<space>=<space>0<lf><space><space><space><space><space><space><space><space>for<space>p<space>in<space>os.listdir<openparen>path<closeparen>:<lf><space><space><space><space><space><space><space><space><space><space><space><space>full_path<space>=<space>os.path.join<openparen>path<comma><space>p<closeparen><lf><space><space><space><space><space><space><space><space><space><space><space><space>if<space>os.path.isfile<openparen>full_path<closeparen>:<lf><space><space><space><space><space><space><space><space><space><space><space><space><space><space><space><space>total<space>+=<space>os.path.getsize<openparen>full_path<closeparen><lf><space><space><space><space><space><space><space><space><space><space><space><space>elif<space>os.path.isdir<openparen>full_path<closeparen>:<lf><space><space><space><space><space><space><space><space><space><space><space><space><space><space><space><space>total<space>+=<space>get_dir_size<openparen>full_path<closeparen><lf><space><space><space><space><space><space><space><space>return<space>total<lf><space><space><space><space>try:<lf><space><space><space><space><space><space><space><space>path<space>=<space>feature.getAttribute<openparen><apos>__filepropertyextractor.path<apos><closeparen><lf><space><space><space><space><space><space><space><space>if<space>os.path.exists<openparen>path<closeparen><space>and<space>not<space>os.path.islink<openparen>path<closeparen>:<lf><space><space><space><space><space><space><space><space><space><space><space><space>s<space>=<space>os.stat<openparen>path<closeparen><lf><space><space><space><space><space><space><space><space><space><space><space><space>if<space>os.path.isdir<openparen>path<closeparen>:<lf><space><space><space><space><space><space><space><space><space><space><space><space><space><space><space><space>feature.setAttribute<openparen><apos>_file_type<apos><comma><space><apos>Directory<apos><closeparen><lf><space><space><space><space><space><space><space><space><space><space><space><space><space><space><space><space>feature.setAttribute<openparen><apos>_file_size<apos><comma><space>get_dir_size<openparen>path<closeparen><closeparen><lf><space><space><space><space><space><space><space><space><space><space><space><space>else:<lf><space><space><space><space><space><space><space><space><space><space><space><space><space><space><space><space>feature.setAttribute<openparen><apos>_file_type<apos><comma><space><apos>File<apos><closeparen><lf><space><space><space><space><space><space><space><space><space><space><space><space><space><space><space><space>feature.setAttribute<openparen><apos>_file_size<apos><comma><space>s.st_size<closeparen><lf><space><space><space><space><space><space><space><space><space><space><space><space>feature.setAttribute<openparen><apos>_file_atime<apos><comma><space>int<openparen>s.st_atime<closeparen><closeparen><lf><space><space><space><space><space><space><space><space><space><space><space><space>feature.setAttribute<openparen><apos>_file_mtime<apos><comma><space>int<openparen>s.st_mtime<closeparen><closeparen><lf><space><space><space><space><space><space><space><space><space><space><space><space>feature.setAttribute<openparen><apos>_file_ctime<apos><comma><space>int<openparen>s.st_ctime<closeparen><closeparen><lf><space><space><space><space><space><space><space><space>else:<lf><space><space><space><space><space><space><space><space><space><space><space><space>raise<space>Exception<openparen><apos>specified<space>file<solidus>directory<space>does<space>not<space>exist<apos><closeparen><lf><space><space><space><space>except<space>Exception<space>as<space>ex:<lf><space><space><space><space><space><space><space><space>feature.setAttribute<openparen><apos>__filepropertyextractor.error<apos><comma><space><apos>%s<apos><space>%<space>ex<closeparen> }    OUTPUT { PYOUTPUT FEATURE_TYPE "$(FilePropertyExtractor_WORKSPACE_NAME)_PythonCaller_OUTPUT"         }
# -------------------------------------------------------------------------
FACTORY_DEF {*} TestFactory    FACTORY_NAME { $(FilePropertyExtractor_WORKSPACE_NAME)_Tester }    INPUT  FEATURE_TYPE "$(FilePropertyExtractor_WORKSPACE_NAME)_PythonCaller_OUTPUT"    TEST { __filepropertyextractor.error ATTRIBUTE_IS_MISSING "" ENCODED }    BOOLEAN_OPERATOR  { OR }    COMPOSITE_TEST_EXPR { "<Unused>" }    OUTPUT { PASSED FEATURE_TYPE "$(FilePropertyExtractor_WORKSPACE_NAME)_Tester_PASSED"         }    OUTPUT { FAILED FEATURE_TYPE "$(FilePropertyExtractor_WORKSPACE_NAME)_Tester_FAILED"         }
# -------------------------------------------------------------------------
# Build the List removal function and regular expression if there was any list attributes to be removed.
# If not, then we will not have any extra list removal call to @RemoveAttributes, which speeds the
# normal, non-list removal especially when in Bulk Mode.  Note that this computation of the regular expressions is done
# once during mapping file parse time.
INCLUDE [    set listAttributeRemoveRegexps {};    set anyList {no};    foreach attr [split ""] {       set attr [FME_DecodeText $attr];       set attr [regsub "{}$" $attr "{}.*"];       set attr [regsub -all "{}" $attr "\\{\[0-9\]+\\}"];       append listAttributeRemoveRegexps ",^$attr$";       set anyList {yes};    };    if { ${anyList} == {no} } {        puts {MACRO $(FilePropertyExtractor_WORKSPACE_NAME)_AttributeRemover_LIST_FUNC }    } else {        puts "MACRO $(FilePropertyExtractor_WORKSPACE_NAME)_AttributeRemover_LIST_FUNC @RemoveAttributes(fme_pcre_match\"$listAttributeRemoveRegexps\")"    }; ]
FACTORY_DEF {*} TeeFactory    FACTORY_NAME { $(FilePropertyExtractor_WORKSPACE_NAME)_AttributeRemover }    INPUT  FEATURE_TYPE "$(FilePropertyExtractor_WORKSPACE_NAME)_Tester_PASSED"    OUTPUT { FEATURE_TYPE "$(FilePropertyExtractor_WORKSPACE_NAME)_AttributeRemover_OUTPUT"        @RemoveAttributes(fme_encoded,__filepropertyextractor.path,__filepropertyextractor.error)        $($(FilePropertyExtractor_WORKSPACE_NAME)_AttributeRemover_LIST_FUNC)         }
# -------------------------------------------------------------------------
Tcl2 proc $(FilePropertyExtractor_WORKSPACE_NAME)_DateFormatter_formatter {invalidValue} {       set dateFormat {$($(FilePropertyExtractor_WORKSPACE_NAME)_FMT)};       if { [string compare $dateFormat {FME Date/Time (%Y%m%d%H%M%S)}] == 0 } {          set dateFormat {%Y%m%d%H%M%S};       } elseif { [string compare $dateFormat {FME Date (%Y%m%d)}] == 0} {          set dateFormat {%Y%m%d};       } elseif { [string compare $dateFormat {FME Time (%H%M%S)}] == 0} {          set dateFormat {%H%M%S};       } elseif { [string compare $dateFormat {ISO Date (%Y-%m-%d)}] == 0} {          set dateFormat {%Y-%m-%d};       } elseif { [string compare $dateFormat {ISO DateTime (%Y-%m-%dT%H:%M:%S)}] == 0} {          set dateFormat {%Y-%m-%dT%H:%M:%S};       } elseif { [string compare $dateFormat {ISO Time (%H:%M:%S)}] == 0} {          set dateFormat {%H:%M:%S};       } elseif { [string compare $dateFormat {Locale Date (%c)}] == 0} {          set dateFormat {%c};       };     set attrs [split {_file_ctime,_file_mtime,_file_atime} {,}];     foreach attr $attrs {        set date [string trim [FME_GetAttribute $attr]];        set comment { Don't touch NULL or empty attribute values };        if { [string length $date] == 0 } { continue; };        set srcfmt {};        if {{%s} != {FME_AUTOMATIC}} {            set srcfmt {%s};        } else {           set comment { In Automatic mode we ignore the millisecond part };           regexp {^[^.]*} $date date;           set comment { Treat single char as invalid date };           if { [regexp {^.$} $date] } {              set date {};           };        };        set comment { An empty $date at this point is invalid, so don't process further };        set dateLen [string length $date];        if {$dateLen > 0} {           if {[string length $srcfmt] == 0} {              set attrFull $attr;              append attrFull .full;              set fullDate [FME_GetAttribute $attrFull];              if { [string compare -length $dateLen $date $fullDate] == 0 } {                 set extra [string range $fullDate $dateLen end]000000;                 set date [string range \"$date$extra\" 0 13];                 set dateLen 14              };              if {($dateLen == 14) && [regexp {^[0-9]*$} $date]} {                 set srcfmt %Y%m%d%H%M%S;              };           };           set sourceFormatOpt {};           if {[string length $srcfmt] > 0} {              set sourceFormatOpt \"-format {$srcfmt}\";           };           set comment { Compute the output value and catch any errors };           set error [catch { set seconds [eval clock scan "{$date}" $sourceFormatOpt];                              set output [clock format $seconds -format $dateFormat];           }];           set comment { If there was error then we try again by removing digits after last decimal };           if { $error != 0 } {              set index [string last "." $date];              if { $index > 0 } {                 set date [eval string range $date 0 [expr $index-1]];                 set dateLen [string length $date];                 set error [catch { set seconds [eval clock scan "{$date}" $sourceFormatOpt]; set output [clock format $seconds -format $dateFormat]; }];              };           };           if { $error == 0 } {              FME_SetAttribute $attr $output;           };        };        if { (0 == $dateLen) || ($error != 0) } {          if { $invalidValue == {FME_NULL_VALUE} } {             FME_SetAttributeNull $attr;          } elseif { $invalidValue != {_FME_NO_OP_} }  {             FME_SetAttribute $attr [FME_DecodeText $invalidValue];          };        };     }; }
FACTORY_DEF {*} TeeFactory    FACTORY_NAME { $(FilePropertyExtractor_WORKSPACE_NAME)_DateFormatter }    INPUT  FEATURE_TYPE "$(FilePropertyExtractor_WORKSPACE_NAME)_AttributeRemover_OUTPUT"    OUTPUT { FEATURE_TYPE "$(FilePropertyExtractor_WORKSPACE_NAME)_DateFormatter_OUTPUT"         @Tcl2("$(FilePropertyExtractor_WORKSPACE_NAME)_DateFormatter_formatter {_FME_NO_OP_}")          }
# -------------------------------------------------------------------------
# Build the List removal function and regular expression if there was any list attributes to be removed.
# If not, then we will not have any extra list removal call to @RemoveAttributes, which speeds the
# normal, non-list removal especially when in Bulk Mode.  Note that this computation of the regular expressions is done
# once during mapping file parse time.
INCLUDE [    set listAttributeRemoveRegexps {};    set anyList {no};    foreach attr [split ""] {       set attr [FME_DecodeText $attr];       set attr [regsub "{}$" $attr "{}.*"];       set attr [regsub -all "{}" $attr "\\{\[0-9\]+\\}"];       append listAttributeRemoveRegexps ",^$attr$";       set anyList {yes};    };    if { ${anyList} == {no} } {        puts {MACRO $(FilePropertyExtractor_WORKSPACE_NAME)_AttributeRemover_2_LIST_FUNC }    } else {        puts "MACRO $(FilePropertyExtractor_WORKSPACE_NAME)_AttributeRemover_2_LIST_FUNC @RemoveAttributes(fme_pcre_match\"$listAttributeRemoveRegexps\")"    }; ]
FACTORY_DEF {*} TeeFactory    FACTORY_NAME { $(FilePropertyExtractor_WORKSPACE_NAME)_AttributeRemover_2 }    INPUT  FEATURE_TYPE "$(FilePropertyExtractor_WORKSPACE_NAME)_Tester_FAILED"    OUTPUT { FEATURE_TYPE "$(FilePropertyExtractor_WORKSPACE_NAME)_AttributeRemover_2_OUTPUT"        @RemoveAttributes(fme_encoded,_file_size,_file_type,_file_ctime,__filepropertyextractor.path,_file_mtime,_file_atime)        $($(FilePropertyExtractor_WORKSPACE_NAME)_AttributeRemover_2_LIST_FUNC)         }
# -------------------------------------------------------------------------
FACTORY_DEF {*} AttrSetFactory    COMMAND_PARM_EVALUATION SINGLE_PASS    FACTORY_NAME { $(FilePropertyExtractor_WORKSPACE_NAME)_AttributeRenamer }    INPUT  FEATURE_TYPE "$(FilePropertyExtractor_WORKSPACE_NAME)_AttributeRemover_2_OUTPUT" 	 ATTRSET_CREATE_DIRECTIVES _PROPAGATE_MISSING_FDIV 	 ATTR_ACTION { "__filepropertyextractor.error" "_rejected_reason" "RENAME_SET_DEFAULT" "" }    OUTPUT { OUTPUT FEATURE_TYPE "$(FilePropertyExtractor_WORKSPACE_NAME)_AttributeRenamer_OUTPUT"        }
FACTORY_DEF * TeeFactory   FACTORY_NAME "$(FilePropertyExtractor_WORKSPACE_NAME)_Output1765552351 Output Collector"   INPUT FEATURE_TYPE "$(FilePropertyExtractor_WORKSPACE_NAME)_DateFormatter_OUTPUT"   OUTPUT FEATURE_TYPE "$(FilePropertyExtractor_WORKSPACE_NAME)_Output"
FACTORY_DEF * TeeFactory   FACTORY_NAME "$(FilePropertyExtractor_WORKSPACE_NAME)_<Rejected>1765552351 Output Collector"   INPUT FEATURE_TYPE "$(FilePropertyExtractor_WORKSPACE_NAME)_AttributeRenamer_OUTPUT"   OUTPUT FEATURE_TYPE "$(FilePropertyExtractor_WORKSPACE_NAME)_<Rejected>"
INCLUDE [puts {MACRO WB_CURRENT_CONTEXT $(WB_OLD_CONTEXT_$(FilePropertyExtractor_WORKSPACE_NAME))}]
FACTORY_DEF * TeeFactory   FACTORY_NAME "FilePropertyExtractor_2 Output Output Renamer/Nuker"   INPUT FEATURE_TYPE FilePropertyExtractor_2_Output   OUTPUT FEATURE_TYPE FilePropertyExtractor_2_Output
FACTORY_DEF * TeeFactory   FACTORY_NAME "FilePropertyExtractor_2 <Rejected> Output Renamer/Nuker"   INPUT FEATURE_TYPE FilePropertyExtractor_2_<Rejected>   OUTPUT FEATURE_TYPE FilePropertyExtractor_2_<Rejected>
DEFAULT_MACRO _WB_BYPASS_TERMINATION No
FACTORY_DEF * TeeFactory FACTORY_NAME FilePropertyExtractor_2_<Rejected> INPUT FEATURE_TYPE FilePropertyExtractor_2_<Rejected>  NO_LOGGING   OUTPUT FAILED FEATURE_TYPE * @Abort(ENCODED, FilePropertyExtractor_2<space>output<space>a<space><lt>Rejected<gt><space>feature.<space><space>To<space>continue<space>translation<space>when<space>features<space>are<space>rejected<comma><space>change<space><apos>Workspace<space>Parameters<apos><space><gt><space>Log<space>and<space>Troubleshoot<space><gt><space><apos>Rejected<space>Feature<space>Handling<apos><space>to<space><apos>Continue<space>Translation<apos>)
# -------------------------------------------------------------------------
FACTORY_DEF {CONNECTED} CreationFactory    FACTORY_NAME { AttributeCreator_2_Creator }    OUTPUT { FEATURE_TYPE AttributeCreator_2_____CREATED______ }
FACTORY_DEF {*} AttrSetFactory    FACTORY_NAME { AttributeCreator_2 }    COMMAND_PARM_EVALUATION SINGLE_PASS    INPUT { FEATURE_TYPE AttributeCreator_2_____CREATED______ }    INPUT  FEATURE_TYPE FilePropertyExtractor_2_Output    MULTI_FEATURE_MODE { NO }    NULL_ATTR_MODE { NO_OP }    ATTRSET_CREATE_DIRECTIVES _PROPAGATE_MISSING_FDIV    NUM_OF_COLUMNS 5    ATTR_ACTION { "" "NewValue" "SET_TO" "<at>Value<openparen>fme_basename<closeparen>_<at>Value<openparen>_file_size<closeparen>" "varchar<openparen>200<closeparen>" }    OUTPUT { OUTPUT FEATURE_TYPE AttributeCreator_2_OUTPUT        }
# -------------------------------------------------------------------------
FACTORY_DEF {*} TestFactory    FACTORY_NAME { Tester_2 }    INPUT  FEATURE_TYPE scotland_and_wales_region_OGCGEOPACKAGE_1    TEST { "@EvaluateExpression(FDIV,STRING_ENCODED,<at>Value<openparen>Name<closeparen>,Tester_2)" = South<space>Wales<space>Central<space>PER ENCODED } TEST { "@EvaluateExpression(FDIV,STRING_ENCODED,<at>Value<openparen>Name<closeparen>,Tester_2)" = South<space>Wales<space>East<space>PER ENCODED } TEST { "@EvaluateExpression(FDIV,STRING_ENCODED,<at>Value<openparen>Name<closeparen>,Tester_2)" = South<space>Wales<space>West<space>PER ENCODED }    BOOLEAN_OPERATOR { OR }    COMPOSITE_TEST_EXPR { "<Unused>" }    PRESERVE_FEATURE_ORDER { PER_OUTPUT_PORT }    OUTPUT { PASSED FEATURE_TYPE Tester_2_PASSED         }
# -------------------------------------------------------------------------
FACTORY_DEF {*} ReprojectFactory    FACTORY_NAME { Reprojector }    INPUT  FEATURE_TYPE Tester_2_PASSED    ENGINE { SOURCE "" DESTINATION "EPSG:4326" }    INTERPOLATION_TYPE { NearestNeighbor }    RASTER_CELL_SIZE { PreserveCells }    RASTER_TOLERANCE { "0.0" }    OUTPUT { REPROJECTED FEATURE_TYPE Reprojector_REPROJECTED          }    OUTPUT { REJECTED FEATURE_TYPE Reprojector_<REJECTED>          }
FACTORY_DEF * TeeFactory   FACTORY_NAME "Reprojector REPROJECTED Splitter"   INPUT FEATURE_TYPE Reprojector_REPROJECTED   OUTPUT FEATURE_TYPE Reprojector_REPROJECTED_0_r8/HWmMuXWw=   OUTPUT FEATURE_TYPE Reprojector_REPROJECTED_1_L2mEoeHZ8X8=
DEFAULT_MACRO _WB_BYPASS_TERMINATION No
FACTORY_DEF * TeeFactory FACTORY_NAME Reprojector_<Rejected> INPUT FEATURE_TYPE Reprojector_<REJECTED>  NO_LOGGING   OUTPUT FAILED FEATURE_TYPE * @Abort(ENCODED, Reprojector<space>output<space>a<space><lt>Rejected<gt><space>feature.<space><space>To<space>continue<space>translation<space>when<space>features<space>are<space>rejected<comma><space>change<space><apos>Workspace<space>Parameters<apos><space><gt><space>Log<space>and<space>Troubleshoot<space><gt><space><apos>Rejected<space>Feature<space>Handling<apos><space>to<space><apos>Continue<space>Translation<apos>)
# -------------------------------------------------------------------------
FACTORY_DEF {*} SpatialFilterFactory    FACTORY_NAME { SpatialFilter }    COMMAND_PARM_EVALUATION SINGLE_PASS    INPUT BASE FEATURE_TYPE Reprojector_REPROJECTED_0_r8/HWmMuXWw=    INPUT CANDIDATE FEATURE_TYPE Extents_GEODATABASE_FILE_1    PRESERVE_FEATURE_ORDER { PER_OUTPUT_PORT }    PREDICATE { "INTERSECTS" }    USE_BOUNDING_BOX { NO }    MULTIPLE_BASES { YES }    MERGE_BASE_ATTR { YES }    ATTR_ACCUM_MODE { "HANDLE_CONFLICT" }    ATTR_CONFLICT_RES { "CANDIDATE_IF_CONFLICT" }    BASE_ATTR_PREFIX { "<Unused>" }    PREDICATE_ATTR { "_predicate" }    BOOLEAN_OPERATOR { OR }    REJECT_INVALID_GEOM Yes    REJECT_INVALID_PREDICATES Yes    REJECT_RASTERS No    ALLOW_NULLS Yes    CUSTOM_MULTI_HANDLING { Yes }    DIMENSION 2    FLUSH_WHEN_GROUPS_CHANGE { <Unused>  }    CURVE_BOUNDARY_RULE { ENDPOINTS_MOD2 }    OUTPUT { PASSED FEATURE_TYPE SpatialFilter_PASSED         }    OUTPUT { REJECTED FEATURE_TYPE SpatialFilter_<REJECTED>         }
DEFAULT_MACRO _WB_BYPASS_TERMINATION No
FACTORY_DEF * TeeFactory FACTORY_NAME SpatialFilter_<Rejected> INPUT FEATURE_TYPE SpatialFilter_<REJECTED>  NO_LOGGING   OUTPUT FAILED FEATURE_TYPE * @Abort(ENCODED, SpatialFilter<space>output<space>a<space><lt>Rejected<gt><space>feature.<space><space>To<space>continue<space>translation<space>when<space>features<space>are<space>rejected<comma><space>change<space><apos>Workspace<space>Parameters<apos><space><gt><space>Log<space>and<space>Troubleshoot<space><gt><space><apos>Rejected<space>Feature<space>Handling<apos><space>to<space><apos>Continue<space>Translation<apos>)
# -------------------------------------------------------------------------
FACTORY_DEF {*} ClipperFactory    FACTORY_NAME { Clipper }    INPUT CLIPPER FEATURE_TYPE Reprojector_REPROJECTED_1_L2mEoeHZ8X8=    INPUT CANDIDATE FEATURE_TYPE SpatialFilter_PASSED    FLUSH_WHEN_GROUPS_CHANGE { <Unused> }    MULTIPLE_CLIPPERS { YES }    CLIPPERS_FIRST { NO }    OVERLAPPING_CLIPPERS { CLIP_OUTSIDE }    INVALID_PARTS_HANDLING { REJECT_WHOLE }    ADD_NODATA { YES }    Z_VAL_SOURCE { CANDIDATE }    MISSING_Z_MODE { PLANAR }    CONNECT_Z_MODE { <Unused> }    M_VAL_SOURCE { CANDIDATE }    MISSING_M_MODE { LINEAR }    CLEANING_TOLERANCE { AUTO }    CANDIDATE_ON_BOUNDARY { INSIDE }    PRESERVE_RASTER_EXTENTS { NO }    RASTER_CELL_MODE { CENTER }    CLIPPED_INDICATOR_ATTR { "_clipped" }    MERGE_CLIPPER_ATTRIBUTES { NO }    ATTR_ACCUM_MODE { "<Unused>" }    ATTR_CONFLICT_RES { "<Unused>" }    CLIPPER_PREFIX { "<Unused>" }    LIST_NAME { "<Unused>" }    LIST_ATTRS_TO_INCLUDE { <Unused> }    LIST_ATTRS_TO_INCLUDE_MODE { <Unused> }    PRESERVE_FEATURE_ORDER { PER_OUTPUT_PORT }    OUTPUT { INSIDE FEATURE_TYPE Clipper_INSIDE         }    OUTPUT { REJECTED FEATURE_TYPE Clipper_<REJECTED>         }
DEFAULT_MACRO _WB_BYPASS_TERMINATION No
FACTORY_DEF * TeeFactory FACTORY_NAME Clipper_<Rejected> INPUT FEATURE_TYPE Clipper_<REJECTED>  NO_LOGGING   OUTPUT FAILED FEATURE_TYPE * @Abort(ENCODED, Clipper<space>output<space>a<space><lt>Rejected<gt><space>feature.<space><space>To<space>continue<space>translation<space>when<space>features<space>are<space>rejected<comma><space>change<space><apos>Workspace<space>Parameters<apos><space><gt><space>Log<space>and<space>Troubleshoot<space><gt><space><apos>Rejected<space>Feature<space>Handling<apos><space>to<space><apos>Continue<space>Translation<apos>)
